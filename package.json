{
  "name": "microfrontends-root",
  "private": true,
  "workspaces": [
    "vue-host",
    "auth-api",
    "react-*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:*\"",
    "dev:backend": "node auth-api/server.js",
    "dev:login": "npm --prefix react-login run dev",
    "dev:signup": "npm --prefix react-signup run dev",
    "dev:profile": "npm --prefix react-profile run dev",
    "dev:dashboard": "npm --prefix react-dashboard run dev",
    "dev:shared": "npm --prefix react-shared-ui run dev",
    "dev:host": "npm --prefix vue-host run dev",
    "build": "npm run build:remotes && node patch-vite.js && npm run build:host",
    "build:remotes": "concurrently \"npm run build:login\" \"npm run build:signup\" \"npm run build:profile\" \"npm run build:dashboard\" \"npm run build:shared\"",
    "build:login": "npm --prefix react-login run build",
    "build:signup": "npm --prefix react-signup run build",
    "build:profile": "npm --prefix react-profile run build",
    "build:dashboard": "npm --prefix react-dashboard run build",
    "build:shared": "npm --prefix react-shared-ui run build",
    "build:host": "npm --prefix vue-host run build",
    "start": "concurrently \"node auth-api/server.js\" \"npm run preview\"",
    "preview": "concurrently \"npm run preview:*\"",
    "preview:login": "npm --prefix react-login run preview",
    "preview:signup": "npm --prefix react-signup run preview",
    "preview:profile": "npm --prefix react-profile run preview",
    "preview:dashboard": "npm --prefix react-dashboard run preview",
    "preview:shared": "npm --prefix react-shared-ui run preview",
    "preview:host": "npm --prefix vue-host run preview"
  },
  "devDependencies": {
    "@originjs/vite-plugin-federation": "^1.4.1",
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "http-proxy-middleware": "^3.0.5"
  }
}